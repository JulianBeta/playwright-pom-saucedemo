{
  "name": "playwright-pom-saucedemo",
  "version": "2.0.0",
  "private": true,
  "description": "Playwright + TypeScript BDD test framework using the Page Object Model, against saucedemo.com",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:regression": "bddgen && playwright test --grep-invert @known-bug",
    "test:known-bugs": "bddgen && playwright test --grep @known-bug",
    "test:visual": "bddgen && playwright test --project=chromium --grep @visual",
    "test:visual:update": "bddgen && playwright test --project=chromium --grep @visual --grep-invert @known-bug --update-snapshots",
    "test:a11y": "bddgen && playwright test --grep @a11y",
    "test:headed": "bddgen && playwright test --project=chromium --headed",
    "test:ui": "bddgen && playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bddgen && tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,feature}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
